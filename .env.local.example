# Server-only Neon PostgreSQL connection (pooled URL for application queries).
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# Optional direct URL for migrations; defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# Supabase is currently used only for authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
